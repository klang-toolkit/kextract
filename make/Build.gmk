include make/Common.gmk

$(eval $(call SetupVariable,PANAMA_JAVA_HOME))
$(eval $(call SetupVariable,LIBCLANG_HOME))
$(eval $(call SetupVariable,LIBCLANG_VERSION,,NO_CHECK))

include make/NativeCompilation.gmk

ifeq ($(PLATFORM_OS), windows)
  JPACKAGE_ARGS := --win-console
else
  JPACKAGE_ARGS :=
endif

ifeq ($(PLATFORM_OS), macosx)
  TAR_SUPPORTS_TRANSFORM := false
else
  TAR_SUPPORTS_TRANSFORM := true
endif

LIBCLANG_LIB_DIR := $(LIBCLANG_HOME)/$(OS_LIB_DIR)
LIBCLANG_INCLUDE_DIR := $(LIBCLANG_HOME)/lib/clang/$(LIBCLANG_VERSION)/include

BUILD_CLASSES_DIR := $(BUILD_DIR)/classes
BUILD_MODULES_DIR := $(BUILD_DIR)/jmods
BUILD_TEST_SUPPORT_DIR := $(BUILD_DIR)/support/test
KEXTRACT_JMOD_LIBS_DIR := $(BUILD_DIR)/kextract_jmod_libs
KEXTRACT_JMOD_CONF_DIR := $(BUILD_DIR)/kextract_jmod_conf

ifeq ($(PLATFORM_OS), macosx)
  BUNDLE_PLATFORM := macos-$(PLATFORM_CPU)
else
  BUNDLE_PLATFORM := $(PLATFORM)
endif

KEXTRACT_BUNDLE_TOP_DIR := $(KEXTRACT_NAME_VERSION)
KEXTRACT_BUNDLE_PREFIX := $(KEXTRACT_NAME_VERSION)-internal+0_$(BUNDLE_PLATFORM)
KEXTRACT_BUNDLE := $(BUILD_DIR)/bundles/$(KEXTRACT_BUNDLE_PREFIX)_bin.tar.gz
KEXTRACT_BUNDLE_TMP_DIR := $(BUILD_DIR)/bundles/tmp/$(KEXTRACT_BUNDLE_TOP_DIR)
KEXTRACT_TESTS_BUNDLE := $(BUILD_DIR)/bundles/$(KEXTRACT_BUNDLE_PREFIX)_bin-tests.tar.gz
KEXTRACT_TEST_JDK_BUNDLE := $(BUILD_DIR)/bundles/$(KEXTRACT_BUNDLE_PREFIX)_bin-testjdk.tar.gz

NATIVE_TEST_SOURCES := $(shell find $(TOPDIR)/test -name "lib*.c")

$(foreach file,$(NATIVE_TEST_SOURCES),$(eval $(call BuildNativeLibrary,$(file),$(KEXTRACT_IMAGE_NATIVE_TEST_DIR),$(BUILD_TEST_SUPPORT_DIR),BUILD_NATIVE_TEST_LIBRARIES)))

$(BUILD_CLASSES_DIR):
	$(MKDIR) -p $(BUILD_CLASSES_DIR)/org/openjdk/kextract/impl
	$(FIXPATH) $(PANAMA_JAVA_HOME)/bin/javac \
	    -d "$(BUILD_CLASSES_DIR)" \
	    --module-source-path org.openjdk.kextract=$(TOPDIR)/src/main/java \
	    -m org.openjdk.kextract
	$(CP) -r src/main/java/META-INF $(BUILD_CLASSES_DIR)/org.openjdk.kextract
	$(CP) -r src/main/resources/org/openjdk/kextract/impl/resources $(BUILD_CLASSES_DIR)/org.openjdk.kextract/org/openjdk/kextract/impl

ifeq ($(PLATFORM_OS), linux)
  LIBCLANG_COPY_PATH := "libclang.so.$(LIBCLANG_VERSION)"
else
  LIBCLANG_COPY_PATH := "*clang.*"
endif

$(BUILD_MODULES_DIR): $(BUILD_CLASSES_DIR)
	$(MKDIR) -p $(BUILD_MODULES_DIR)
	$(MKDIR) -p $(KEXTRACT_JMOD_LIBS_DIR)
	$(MKDIR) -p $(KEXTRACT_JMOD_CONF_DIR)

	# Copy libclang library and header files
	$(CP) "$(LIBCLANG_LIB_DIR)/$(LIBCLANG_COPY_PATH)" "$(KEXTRACT_JMOD_LIBS_DIR)"
	$(MKDIR) -p "$(KEXTRACT_JMOD_CONF_DIR)/kextract"
	$(CP) "$(LIBCLANG_INCLUDE_DIR)/"*.h "$(KEXTRACT_JMOD_CONF_DIR)/kextract/"
	[ ! -f $(KEXTRACT_JMOD_LIBS_DIR)/libclang.so.$(LIBCLANG_VERSION) ] || \
	  $(MV) "$(KEXTRACT_JMOD_LIBS_DIR)/libclang.so.$(LIBCLANG_VERSION)" "$(KEXTRACT_JMOD_LIBS_DIR)/libclang.so"

	# create kextract jmod file
	$(FIXPATH) $(PANAMA_JAVA_HOME)/bin/jmod \
	    create \
	    --module-version=25 \
	    --class-path=$(BUILD_CLASSES_DIR)/org.openjdk.kextract \
	    --libs=$(KEXTRACT_JMOD_LIBS_DIR) \
	    --conf=$(KEXTRACT_JMOD_CONF_DIR) \
	    $(BUILD_MODULES_DIR)/org.openjdk.kextract.jmod

$(KEXTRACT_IMAGE_DIR): $(BUILD_MODULES_DIR)
        # jlink the modules to create a custom runtime image for kextract
	$(FIXPATH) $(PANAMA_JAVA_HOME)/bin/jlink \
	    --output "$(KEXTRACT_IMAGE_DIR)/runtime" \
	    --module-path "$(BUILD_MODULES_DIR)" \
	    --add-modules org.openjdk.kextract \
	    --add-options "\"--enable-native-access=org.openjdk.kextract\""
	$(MKDIR) $(KEXTRACT_IMAGE_DIR)/bin
	$(CP) src/main/kextract "$(KEXTRACT_IMAGE_DIR)/bin"
	$(CP) src/main/kextract.bat "$(KEXTRACT_IMAGE_DIR)/bin"
	$(CP) src/main/kextract.ps1 "$(KEXTRACT_IMAGE_DIR)/bin"
	$(CHMOD) +x "$(KEXTRACT_IMAGE_DIR)/bin/kextract"

$(KEXTRACT_IMAGE_TEST_JDK_DIR): $(KEXTRACT_IMAGE_DIR)
        # jlink the modules to create a custom runtime image for kextract testing
	$(FIXPATH) $(PANAMA_JAVA_HOME)/bin/jlink \
	    -J-Djlink.debug=true \
	    --output "$(KEXTRACT_IMAGE_TEST_JDK_DIR)" \
	    --module-path "$(BUILD_MODULES_DIR):$(PANAMA_JAVA_HOME)/jmods" \
	    --add-modules ALL-MODULE-PATH


$(KEXTRACT_BUNDLE): $(KEXTRACT_IMAGE_DIR)
	@$(MKDIR) -p $(@D)
ifeq ($(TAR_SUPPORTS_TRANSFORM),true)
	$(TAR) zcf $@ --transform 's|^$(KEXTRACT_NAME)|$(KEXTRACT_BUNDLE_TOP_DIR)|S' -C $(dir $(KEXTRACT_IMAGE_DIR)) $(notdir $(KEXTRACT_IMAGE_DIR))
else
	$(RM) -r $(KEXTRACT_BUNDLE_TMP_DIR)
	$(MKDIR) -p $(KEXTRACT_BUNDLE_TMP_DIR)
	($(CD) $(KEXTRACT_IMAGE_DIR) && $(TAR) cf - .) | ($(CD) $(KEXTRACT_BUNDLE_TMP_DIR) && $(TAR) xf -)
	$(TAR) zcf $@ -C $(dir $(KEXTRACT_BUNDLE_TMP_DIR)) $(notdir $(KEXTRACT_BUNDLE_TMP_DIR))
endif

$(KEXTRACT_TESTS_BUNDLE): $(BUILD_NATIVE_TEST_LIBRARIES)
	@$(MKDIR) -p $(@D)
	$(TAR) zcf $@ -C $(dir $(KEXTRACT_IMAGE_NATIVE_TEST_DIR)) $(notdir $(KEXTRACT_IMAGE_NATIVE_TEST_DIR))

$(KEXTRACT_TEST_JDK_BUNDLE): $(KEXTRACT_IMAGE_TEST_JDK_DIR)
	@$(MKDIR) -p $(@D)
	$(TAR) zcf $@ -C $(dir $(KEXTRACT_IMAGE_TEST_JDK_DIR)) $(notdir $(KEXTRACT_IMAGE_TEST_JDK_DIR))


compile-java: $(BUILD_CLASSES_DIR)

image: $(KEXTRACT_IMAGE_DIR)

test-image: $(BUILD_NATIVE_TEST_LIBRARIES) $(KEXTRACT_IMAGE_TEST_JDK_DIR)

images: image test-image

bundles: $(KEXTRACT_BUNDLE) $(KEXTRACT_TESTS_BUNDLE) $(KEXTRACT_TEST_JDK_BUNDLE)

.PHONY: compile-java image test-image images bundles
